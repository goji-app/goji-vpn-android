<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Установка скачанного самим приложением APK-обновления (см. AppUpdateDownloader) —
         не из Google Play. Само по себе разрешение ничего не открывает: Android при первой
         попытке install-интента сам покажет системный экран "Разрешить установку из этого
         источника" для Godji VPN, если он ещё не выдан. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Без этого на Android 11+ (API 30+) PackageManager.getInstalledApplications() видит
         только сами себя и приложения, с которыми уже было явное взаимодействие (package
         visibility) — экран "Прокси для выбранных приложений" получал бы почти пустой список
         вместо всех установленных пакетов. Не требует ручной проверки в Google Play, потому
         что приложение распространяется не через Play Store. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".GodjiApplication"
        android:allowBackup="false"
        android:label="Goji VPN"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.GodjiVpn"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.GodjiVpn">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ловит редирект из Native OAuth (Google/Yandex/Telegram) после серверного callback.
             Схему godjivpn://oauth2redirect нужно один раз внести в панели: Настройки →
             Мобильные приложения → "Разрешённые схемы app_redirect". -->
        <activity
            android:name=".auth.OAuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="godjivpn"
                    android:host="oauth2redirect" />
            </intent-filter>
        </activity>

        <!-- WebView-логин: обходной путь для сломанного на бэкенде 7.1.0 native/exchange (см.
             WebLoginActivity) — запускается только из LoginScreen, наружу не экспортируется. -->
        <activity
            android:name=".auth.WebLoginActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- Сам VPN-туннель. BIND_VPN_SERVICE — системное разрешение, декларируется на сервисе -->
        <service
            android:name=".vpn.GodjiVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Виджет на главный экран (см. GojiWidgetProvider) — статус + кнопка подключения.
             exported=true обязателен для AppWidgetProvider: APPWIDGET_UPDATE шлёт system_server
             от имени лончера, и на части прошивок/версий Android такая доставка не проходит до
             ресивера с exported=false, несмотря на то что сам intent-action защищённый. Сюда
             приходят только системные широковещания жизненного цикла виджета (APPWIDGET_UPDATE/
             OPTIONS_CHANGED) — сам провайдер только перерисовывает виджет по внутреннему
             состоянию, никаких действий с реальным эффектом не выполняет. -->
        <receiver
            android:name=".widget.GojiWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_goji_info" />
        </receiver>

        <!-- Выбор сервера/подключение из виджета (см. GojiWidgetActionReceiver) — в отличие от
             GojiWidgetProvider выше, exported=false: эти действия реально меняют текущий узел
             подписки и поднимают VPN, а не просто перерисовывают виджет, поэтому стороннему
             приложению сюда доступа быть не должно. PendingIntent, которые создаёт сам виджет
             (кнопка/строка списка), долетают сюда независимо от exported — это разрешение
             переносится вместе с самим PendingIntent, а не проверяется заново на приёме. -->
        <receiver
            android:name=".widget.GojiWidgetActionReceiver"
            android:exported="false" />

        <!-- Ловит завершение загрузки APK-обновления (см. AppUpdateDownloader) — системный
             DownloadManager переживает смерть процесса приложения, поэтому регистрация
             только в манифесте, не динамическая. exported=false: сам DOWNLOAD_COMPLETE —
             защищённый системный broadcast, сторонним приложениям его не разослать. -->
        <receiver
            android:name=".update.UpdateDownloadReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Список серверов внутри развёрнутого (3x3) виджета — см.
             GojiWidgetRemoteViewsService/widget_goji_expanded.xml. BIND_REMOTEVIEWS — системное
             разрешение, гарантирует, что подключаться к сервису может только сам системный
             процесс лончера/виджет-хоста, а не произвольное приложение. -->
        <service
            android:name=".widget.GojiWidgetRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- WorkManager инициализируется вручную через HiltWorkerFactory в GodjiApplication
             (Configuration.Provider) — стандартный провайдер-инициализатор нужно снять,
             иначе он создаст WorkManager без Hilt-инъекции до onCreate() приложения. -->
        <!-- Отдаёт скачанный APK-файл обновления системному установщику через content://
             (Android 7+ запрещает передавать file://-URI между приложениями) — см.
             AppUpdateDownloader.installApk(). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
